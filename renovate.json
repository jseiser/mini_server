{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "ansible": {
    "managerFilePatterns": [
      "/(^|/)group_vars/all$/"
    ]
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)group_vars/all$/"
      ],
      "matchStrings": [
        "image:\\s*\"(?<depName>lscr\\.io/linuxserver/[^:\"]+):(?<currentValue>amd64-v?[0-9]+(?:\\.[0-9]+){2,3}-ls[0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^amd64-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-ls\\d+$"
    }
  ],

  "packageRules": [
    {
      "description": "Group all Docker image updates together",
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker image updates"
    },
    {
      "description": "Group all non-Docker updates together",
      "matchPackageNames": [
        "*"
      ],
      "excludeDatasources": [
        "docker"
      ],
      "groupName": "ansible updates"
    }
  ]
}
