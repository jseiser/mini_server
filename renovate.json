{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "ansible": {
    "managerFilePatterns": [
      "/(^|/)group_vars/all$/"
    ]
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)group_vars/all$/"
      ],
      "matchStrings": [
        "image:\\s*\"(?<depName>lscr\\.io/linuxserver/[^:\"]+):(?<currentValue>amd64-v?[0-9][^\"\\s]*-ls[0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^amd64-v?(?<version>[0-9]+(?:\\.[0-9]+)*)-ls[0-9]+$"
    }
  ],

  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "docker images"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/**"
      ],
      "allowedVersions": "/^amd64-v?[0-9]+(?:\\.[0-9]+)*-ls[0-9]+$/"
    }
  ]
}
